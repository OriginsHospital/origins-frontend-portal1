{
  "name": "origins-frontend-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "mobile:icons": "npx capacitor-assets generate --android",
    "mobile:live": "node scripts/link-mobile.mjs on",
    "mobile:unlink": "node scripts/link-mobile.mjs off",
