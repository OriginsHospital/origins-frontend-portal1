    "mobile:apk": "node scripts/build-apk.mjs",
    "mobile:build": "npm run mobile:sync && npm run mobile:apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
