    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "framer-motion": "^12.43.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1"
