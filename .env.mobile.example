# Backend the packaged APK talks to directly (no Next.js proxy in the APK).
# Production (works on mobile data from anywhere):
NEXT_PUBLIC_API_BASE_URL=https://api.originshms.com
# Local LAN only (same Wi‑Fi as PC):
# NEXT_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:3003
# Emulator → host machine HTTP:
# NEXT_PUBLIC_API_BASE_URL=http://10.0.2.2:3003
MOBILE_BUILD=1

# Optional: pin live-link URL used by `npm run mobile:live`
# (default auto-detects PC LAN IP + port 3002)
# CAPACITOR_SERVER_URL=http://YOUR_PC_LAN_IP:3002
